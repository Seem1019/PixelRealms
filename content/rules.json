  "classAdvantage": {
    "_doc": "Multiplicador de daño del atacante (fila) sobre el defensor (columna) en PvP. 1.0 = sin ajuste. Palanca fina del triángulo; la identidad la dan los hechizos.",
    "warrior": { "warrior": 1.0, "rogue": 1.0, "mage": 1.0, "priest": 1.0 },
    "rogue":   { "warrior": 1.0, "rogue": 1.0, "mage": 1.0, "priest": 1.0 },
    "mage":    { "warrior": 1.0, "rogue": 1.0, "mage": 1.0, "priest": 1.0 },
    "priest":  { "warrior": 1.0, "rogue": 1.0, "mage": 1.0, "priest": 1.0 }
  },

  "pvp": {
    "rulesets": {
      "duel": { "requiresConsent": true, "endAtHpPct": 0.01, "restoreOnEnd": true, "xpLoss": 0, "goldLoss": 0, "itemLoss": false, "allowedInSafeZones": true, "requestExpireSec": 30, "countdownSec": 3, "maxDistanceTiles": 30 }
    },
    "defaultRuleset": "duel",
    "enabledRulesets": ["duel"]
  },

  "loot": {
    "ownerMode": "random_per_item",
    "exclusiveSec": 30,
    "lootRangeTiles": 2,
    "eligibleRangeTiles": 40,
    "goldSplit": "equal",
    "announceRarityFrom": "uncommon"
  },

  "economy": {
    "vendorBuyMultiplier": 4,
    "vendorRangeTiles": 3,
    "copperPerSilver": 100,
    "silverPerGold": 100
  },

  "boss": {
    "_doc": "Objetivo de diseño de cada jefe de nivel B: 3 jugadores de nivel B-2 con equipo de su nivel lo matan en targetDurationSec; 2 de nivel B también; 1 de nivel B+1 con 1 de nivel B-1 igual.",
    "referencePartySize": 3,
    "referenceLevelOffset": -2,
    "targetDurationSec": [60, 100],
    "soloKillable": false
  },

  "movement": {
    "baseSpeedTilesPerSec": 4,
    "sayRangeTiles": 20,
    "aoiCellTiles": 16
  },

  "world": {
    "startMapId": "meadow",
    "mvpTier": 1,
    "zoneCrossTimeSecTarget": [60, 90]
