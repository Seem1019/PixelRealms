{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "classes.schema.json",
  "title": "Clases jugables",
  "type": "object",
  "required": ["classes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "resource", "baseHp", "baseStats", "statsPerLevel", "allowedWeapons", "allowedArmor", "startingItems", "sprite", "description"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/classId" },
          "name": { "type": "string" },
          "role": { "enum": ["tank", "melee_dps", "ranged_dps", "healer"] },
          "resource": { "$ref": "common.schema.json#/$defs/resource" },
          "baseHp": { "type": "integer", "minimum": 1 },
          "baseMana": { "type": "integer", "minimum": 0, "description": "Solo si resource = mana" },
          "baseStats": { "$ref": "common.schema.json#/$defs/stats" },
          "statsPerLevel": { "$ref": "common.schema.json#/$defs/stats" },
          "allowedWeapons": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/weaponType" }, "minItems": 1, "uniqueItems": true },
          "allowedArmor": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/armorType" }, "minItems": 1, "uniqueItems": true },
          "startingItems": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["itemId"],
              "properties": {
                "itemId": { "$ref": "common.schema.json#/$defs/id" },
                "qty": { "type": "integer", "minimum": 1, "default": 1 },
                "equip": { "type": "boolean", "default": false }
              }
            }
          },
          "sprite": { "type": "string" },
          "description": { "$ref": "common.schema.json#/$defs/localizedText" }
        }
      }
    }
  }
}
