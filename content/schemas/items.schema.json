{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "items.schema.json",
  "title": "Plantillas de items",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "type",
          "rarity",
          "icon",
          "sellPrice"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "weapon",
              "armor",
              "consumable",
              "material",
              "junk"
            ]
          },
          "rarity": {
            "$ref": "common.schema.json#/$defs/rarity"
          },
          "levelReq": {
            "$ref": "common.schema.json#/$defs/level",
            "default": 1
          },
          "slot": {
            "$ref": "common.schema.json#/$defs/equipSlot"
          },
          "weaponType": {
            "$ref": "common.schema.json#/$defs/weaponType"
          },
          "armorType": {
            "$ref": "common.schema.json#/$defs/armorType"
          },
          "damageMin": {
            "type": "integer",
            "minimum": 1
          },
          "damageMax": {
            "type": "integer",
            "minimum": 1
          },
          "speedMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 4000
          },
          "armor": {
            "type": "integer",
            "minimum": 0
          },
          "spellPower": {
            "type": "integer",
            "minimum": 0
          },
          "stats": {
            "$ref": "common.schema.json#/$defs/stats"
          },
          "maxStack": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 1
          },
          "useSpellId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "useCooldownMs": {
            "type": "integer",
            "minimum": 0
          },
          "sellPrice": {
            "type": "integer",
            "minimum": 0,
            "description": "En cobre"
          },
          "vendorPrice": {
            "type": "integer",
            "minimum": 1,
            "description": "Precio de compra en NPC. Por defecto sellPrice × rules.economy.vendorBuyMultiplier; solo ponerlo para excepciones."
          },
          "icon": {
            "type": "string"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/localizedText"
          },
          "scaling": {
            "enum": [
              "str",
              "agi",
              "int"
            ],
            "description": "Stat que escala el ataque básico de esta arma (str/agi → físico con attackPower; int → mágico con spellPower, rango 6)."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "weapon"
                }
              }
            },
            "then": {
              "required": [
                "slot",
                "weaponType",
                "damageMin",
                "damageMax",
                "speedMs",
                "scaling"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "armor"
                }
              }
            },
            "then": {
              "required": [
                "slot",
                "armorType"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "consumable"
                }
              }
            },
            "then": {
              "required": [
                "useSpellId",
                "maxStack"
              ]
            }
          }
        ]
      }
    }
  }
}
