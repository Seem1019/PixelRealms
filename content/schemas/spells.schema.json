{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spells.schema.json",
  "title": "Hechizos y habilidades",
  "type": "object",
  "required": [
    "spells"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "spells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/spell"
      }
    }
  },
  "$defs": {
    "spell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source",
        "school",
        "castMs",
        "cooldownMs",
        "range",
        "targeting",
        "effects",
        "icon",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "enum": [
            "class",
            "item",
            "monster"
          ]
        },
        "classId": {
          "$ref": "common.schema.json#/$defs/classId"
        },
        "levelReq": {
          "$ref": "common.schema.json#/$defs/level"
        },
        "school": {
          "$ref": "common.schema.json#/$defs/school"
        },
        "castMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "cooldownMs": {
          "type": "integer",
          "minimum": 0
        },
        "triggersGcd": {
          "type": "boolean",
          "default": true
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resource",
            "amount"
          ],
          "properties": {
            "resource": {
              "$ref": "common.schema.json#/$defs/resource"
            },
            "amount": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "range": {
          "type": "number",
          "minimum": 0,
          "description": "En tiles. 0 = sobre uno mismo."
        },
        "targeting": {
          "enum": [
            "self",
            "enemy",
            "ally",
            "self_aoe_enemies",
            "self_aoe_allies",
            "ground_aoe_enemies",
            "ground_aoe_allies",
            "ground_aoe_all"
          ],
          "description": "Un objetivo (tab-target): self, enemy, ally (ally incluye a uno mismo si no hay aliado seleccionado). Área (ADR-015/016): self_aoe_* alrededor del lanzador; ground_aoe_* en targetPos (el cono y la línea salen del lanzador hacia targetPos). ground_aoe_all aplica los efectos positivos a aliados y los negativos a enemigos."
        },
        "aoeRadius": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 10
        },
        "maxTargets": {
          "type": "integer",
          "minimum": 1,
          "default": 10
        },
        "projectile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sprite",
            "speed"
          ],
          "properties": {
            "sprite": {
              "type": "string"
            },
            "speed": {
              "type": "number",
              "description": "tiles/s; solo visual, el servidor retrasa el impacto dist/speed"
            }
          }
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "icon": {
          "type": "string"
        },
        "vfx": {
          "type": "string"
        },
        "description": {
          "$ref": "common.schema.json#/$defs/localizedText"
        },
        "shape": {
          "enum": [
            "circle",
            "cone",
            "line"
          ],
          "default": "circle",
          "description": "Forma del área (ADR-016). circle: aoeRadius; cone: aoeRadius + aoeAngleDeg; line: aoeLength + aoeWidth."
        },
        "aoeAngleDeg": {
          "type": "number",
          "minimum": 10,
          "maximum": 180,
          "description": "Apertura del cono en grados."
        },
        "aoeLength": {
          "type": "number",
          "minimum": 1,
          "maximum": 15,
          "description": "Longitud de la línea en tiles."
        },
        "aoeWidth": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 5,
          "description": "Ancho de la línea en tiles."
        },
        "provisional": {
          "type": "boolean",
          "description": "true = números provisionales, pendientes de la pasada del content-designer; false = medidos con tools/balance/ (docs/design/balance-report.md)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "class"
              }
            }
          },
          "then": {
            "required": [
              "classId",
              "levelReq",
              "cost"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "targeting": {
                "enum": [
                  "self_aoe_enemies",
                  "self_aoe_allies",
                  "ground_aoe_enemies",
                  "ground_aoe_allies",
                  "ground_aoe_all"
                ]
              }
            },
            "required": [
              "targeting"
            ]
          },
          "then": {
            "if": {
              "properties": {
                "shape": {
                  "const": "line"
                }
              },
              "required": [
                "shape"
              ]
            },
            "then": {
              "required": [
                "aoeLength",
                "aoeWidth"
              ]
            },
            "else": {
              "required": [
                "aoeRadius"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "cone"
              }
            },
            "required": [
              "shape"
            ]
          },
          "then": {
            "required": [
              "aoeAngleDeg"
            ]
          }
        }
      ]
    },
    "effect": {
      "type": "object",
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "damage"
            },
            "base": {
              "type": "number",
              "minimum": 0
            },
            "apCoef": {
              "type": "number",
              "minimum": 0
            },
            "spCoef": {
              "type": "number",
              "minimum": 0
            },
            "weaponPct": {
              "type": "number",
              "minimum": 0,
              "description": "% del golpe de arma sumado (1.0 = 100%)"
            },
            "applyTo": {
              "enum": [
                "targets",
                "self"
              ],
              "default": "targets",
              "description": "self: el efecto se aplica al lanzador aunque el hechizo sea de área o de salto."
            }
          },
          "required": [
            "type",
            "base"
          ]
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "heal"
            },
            "base": {
              "type": "number",
              "minimum": 0
            },
            "spCoef": {
              "type": "number",
              "minimum": 0
            },
            "applyTo": {
              "enum": [
                "targets",
                "self"
              ],
              "default": "targets",
              "description": "self: el efecto se aplica al lanzador aunque el hechizo sea de área o de salto."
            },
            "bonusBelowHpPct": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "description": "Si el objetivo está por debajo de este % de vida, la cura se multiplica por bonusMult."
            },
            "bonusMult": {
              "type": "number",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "base"
          ]
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "restore_resource"
            },
            "resource": {
              "$ref": "common.schema.json#/$defs/resource"
            },
            "amount": {
              "type": "integer",
              "minimum": 1
            },
            "applyTo": {
              "enum": [
                "targets",
                "self"
              ],
              "default": "targets",
              "description": "self: el efecto se aplica al lanzador aunque el hechizo sea de área o de salto."
            }
          },
          "required": [
            "type",
            "resource",
            "amount"
          ]
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "apply_aura"
            },
            "auraId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "applyTo": {
              "enum": [
                "targets",
                "self"
              ],
              "default": "targets",
              "description": "self: el efecto se aplica al lanzador aunque el hechizo sea de área o de salto."
            }
          },
          "required": [
            "type",
            "auraId"
          ]
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "taunt"
            },
            "durationMs": {
              "type": "integer",
              "minimum": 500
            },
            "applyTo": {
              "enum": [
                "targets",
                "self"
              ],
              "default": "targets",
              "description": "self: el efecto se aplica al lanzador aunque el hechizo sea de área o de salto."
            }
          },
          "required": [
            "type",
            "durationMs"
          ]
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "dash"
            },
            "minRange": {
              "type": "number",
              "minimum": 0,
              "description": "Distancia mínima al objetivo para poder usarlo"
            },
            "applyTo": {
              "enum": [
                "targets",
                "self"
              ],
              "default": "targets",
              "description": "self: el efecto se aplica al lanzador aunque el hechizo sea de área o de salto."
            }
          },
          "required": [
            "type"
          ],
          "description": "El lanzador se desplaza hasta quedar adyacente al objetivo (servidor teletransporta en ≤ 3 ticks; cliente interpola). Requiere targeting enemy y LOS."
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "leap"
            },
            "maxRange": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Distancia máxima del salto en tiles."
            },
            "travelMs": {
              "type": "integer",
              "minimum": 0,
              "description": "Duración del salto; 0 = teletransporte."
            },
            "applyTo": {
              "enum": [
                "targets",
                "self"
              ],
              "default": "targets",
              "description": "self: el efecto se aplica al lanzador aunque el hechizo sea de área o de salto."
            }
          },
          "required": [
            "type",
            "maxRange"
          ],
          "description": "Salto a targetPos (ADR-016, HU-087): lo mueve el servidor; los efectos siguientes se aplican en el punto de llegada."
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "interrupt"
            },
            "applyTo": {
              "enum": [
                "targets",
                "self"
              ],
              "default": "targets",
              "description": "self: el efecto se aplica al lanzador aunque el hechizo sea de área o de salto."
            }
          },
          "required": [
            "type"
          ],
          "description": "Corta el casteo del objetivo y aplica rules.combat.interruptLockoutMs (ADR-019)."
        }
      ]
    }
  }
}
