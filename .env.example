# Copia este archivo a .env (ignorado por git). Nunca subas secretos al repo (regla 8 de CLAUDE.md).
POSTGRES_USER=pixelrealms
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=pixelrealms
# Clave HS256 del JWT (>= 32 bytes aleatorios). En desarrollo también puede ir en `dotnet user-secrets`.
JWT_SIGNING_KEY=cambia-esta-clave-por-32-bytes-aleatorios-o-mas
# --- Producción (docker-compose.prod.yml, HU-073) ---
# Dominio con DNS apuntando al VPS; Caddy pide el certificado solo.
DOMAIN=juego.ejemplo.com
# Imagen publicada por el GitHub Action (deploy.yml). Deja el valor por defecto si construyes en el VPS.
SERVER_IMAGE=ghcr.io/OWNER/pixelrealms-server:latest
# POSTGRES_HOST solo hace falta fuera de compose (en compose el servidor usa el servicio `postgres`).
# POSTGRES_HOST=localhost
