# Copia este archivo a .env (ignorado por git). Nunca subas secretos al repo (regla 8 de CLAUDE.md).
POSTGRES_USER=pixelrealms
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=pixelrealms
# Clave HS256 del JWT (>= 32 bytes aleatorios). En desarrollo también puede ir en `dotnet user-secrets`.
JWT_SIGNING_KEY=cambia-esta-clave-por-32-bytes-aleatorios-o-mas
