* text=auto
*.gd text eol=lf
*.cs text eol=lf
*.json text eol=lf
*.tmj text eol=lf
*.tsj text eol=lf
*.md text
*.sh text eol=lf
*.png filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
# Addons de terceros (GUT, YATI) se versionan tal cual, sin LFS: viajan completos en clones y bundles.
client/addons/** -filter -diff -merge text=auto
# Arte generado por tools/art (ADR-026) y capturas de referencia: archivos pequeños, sin LFS (el entorno de trabajo
# no puede subir a lfs.github.com) y binarios.
client/assets/** -filter -diff -merge -text
docs/screenshots/** -filter -diff -merge -text
