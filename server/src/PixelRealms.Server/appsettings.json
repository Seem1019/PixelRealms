{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls": "http://localhost:5080",
  "Net": {
    "IdleTimeoutSec": 15,
    "RequireTicket": true,
    "RateLimits": {
      "MoveInputPerSec": 30,
      "MoveInputBurst": 90,
      "CastSpellPerSec": 10,
      "ChatPerSec": 1,
      "ChatBurst": 5,
      "DefaultPerSec": 20,
      "MaxExcess": 3,
      "ExcessWindowSec": 10,
      "MaxConnectionsPerIp": 10
    }
  },
  "Persistence": {
    "Provider": "Postgres",
    "AutosaveSec": 60
  }
}
